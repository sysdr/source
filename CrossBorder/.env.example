# Copy to .env and fill in values. Never commit .env.
GEMINI_API_KEY=
API_KEY=

# Optional
# VITE_SERVER_URL=http://localhost:3001
# SUEZ_API_KEY=

# Stripe (REQ-078 / ADR-003)
# STRIPE_WEBHOOK_SECRET=whsec_...          # enables Stripe-Signature verification
# STRIPE_WEBHOOK_ORG_ID=default            # org mapping for signed webhooks
# STRIPE_WEBHOOK_BASE_CURRENCY=INR
# FF_STRIPE_WEBHOOK_INGEST=true            # set false to dark-deploy webhooks
# FF_STRIPE_SERVER_SYNC=true

# LAN access (API binds 0.0.0.0 by default so Wi‑Fi peers can connect)
# HOST=0.0.0.0
# PORT=3001
# CORS_ALLOW_LAN=true
# CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# Public app URL used in invite / magic-link emails (prefer LAN IP, not localhost)
# APP_BASE_URL=http://192.168.1.7:9000
# APP_FRONTEND_PORT=9000

# Optional Vite overrides
# VITE_SERVER_URL=http://192.168.1.7:3001
# VITE_APP_BASE_URL=http://192.168.1.7:9000
