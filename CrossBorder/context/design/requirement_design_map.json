      "risk": "Requirement conflict between single-user wording and accountant invite flow",
      "affected_requirements": ["REQ-070", "REQ-073"],
      "mitigation": "Treat REQ-070 as single-writer policy and create explicit requirement amendment in next specify cycle."
    },
    {
      "id": "DR-002",
      "risk": "Regulatory export formats can change and break contracts",
      "affected_requirements": ["REQ-007", "REQ-008", "REQ-009", "REQ-010", "REQ-014", "REQ-048", "REQ-049", "REQ-050"],
      "mitigation": "Version schema fixtures and gate releases on contract-test pass."
